# SPDX-License-Identifier: Apache-2.0
@PACKAGE_INIT@

set(APTA_VERSION_FULL "@APTA_VERSION_FULL@")
set(APTA_SHARED_PACKAGE @APTA_PACKAGE_IS_SHARED@)
set(APTA_RUNTIME_DIR "${PACKAGE_PREFIX_DIR}/@APTA_PACKAGE_RUNTIME_RELATIVE_DIR@")

if(NOT TARGET apta::headers)
    add_library(apta::headers INTERFACE IMPORTED)
    set_target_properties(
        apta::headers
        PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES
                "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@"
            INTERFACE_COMPILE_FEATURES "c_std_11;cxx_std_11")
endif()

if(NOT TARGET apta::core)
    add_library(apta::core @APTA_IMPORTED_LIBRARY_TYPE@ IMPORTED)
    set_target_properties(
        apta::core
        PROPERTIES
            IMPORTED_LOCATION
                "${PACKAGE_PREFIX_DIR}/@APTA_PACKAGE_LIBRARY_RELATIVE_PATH@"
            INTERFACE_LINK_LIBRARIES
                "apta::headers@APTA_PACKAGE_LINK_SUFFIX@")
@APTA_PACKAGE_IMPLIB_PROPERTY@
@APTA_PACKAGE_SHARED_DEFINITION@
endif()

check_required_components(APTA)
