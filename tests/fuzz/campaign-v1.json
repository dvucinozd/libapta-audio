{
  "schema": "apta-fuzz-campaign-policy-1",
  "campaign_version": "APTA-1.0-P7.1",
  "engine": "libFuzzer",
  "sanitizers": [
    "address",
    "undefined"
  ],
  "policy": {
    "minimum_executions_per_target": 8192,
    "minimum_aggregate_executions": 73728,
    "timeout_seconds": 5,
    "rss_limit_mb": 512,
    "malloc_limit_mb": 128,
    "zero_crashes": true,
    "zero_hangs": true,
    "zero_sanitizer_findings": true
  },
  "targets": [
